rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Menu images can be read by anyone, written by authenticated staff/admin
    match /menu/{allImages=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Categories images can be read by anyone, written by staff/admin
    match /categories/{allImages=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Customer profile photos - readable by anyone or auth users, user can upload their own
    match /profiles/{userId}/{allImages=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');
    }
    
    // General assets
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
