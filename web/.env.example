# ================================================================
# SMARTDINE WEB & RAZORPAY ENVIRONMENT CONFIGURATION
# ================================================================

# Razorpay API Credentials
# Get these from https://dashboard.razorpay.com/#/app/keys
# For Testing: Use keys starting with rzp_test_
# For Production: Use keys starting with rzp_live_

# Server-Side credentials (REQUIRED for serverless APIs: /api/create-razorpay-order, /api/verify-razorpay-payment)
# WARNING: NEVER expose RAZORPAY_KEY_SECRET to the frontend/browser client!
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Client-Side credential (Used by Razorpay Checkout JS modal in the browser)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
